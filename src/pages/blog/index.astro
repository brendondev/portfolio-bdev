---
import MainLayout from '@/layouts/MainLayout.astro';
import PostCard from '@/components/PostCard.astro';
import SearchInput from '@/components/SearchInput.astro';
import TagPill from '@/components/TagPill.astro';
import { getPosts, getAllTags, searchContent } from '@/lib';

const posts = await getPosts();
const allTags = getAllTags([], posts);

const ITEMS_PER_PAGE = 9;
const totalPages = Math.ceil(posts.length / ITEMS_PER_PAGE);
const currentPage = 1;
const paginatedPosts = posts.slice(0, ITEMS_PER_PAGE);
---

<MainLayout title="Blog | Seu Nome" description="Artigos sobre desenvolvimento web, design, SEO e tendências digitais.">
  <div class="page-header">
    <div class="container-custom">
      <h1 class="page-title">Blog</h1>
      <p class="page-description">
        Artigos sobre desenvolvimento, design e tendências do mundo digital.
      </p>
    </div>
  </div>
  
  <section class="py-12 bg-white dark:bg-dark-900">
    <div class="container-custom">
      <div class="flex flex-col lg:flex-row gap-8 mb-12">
        <div class="lg:w-1/3">
          <SearchInput placeholder="Buscar artigos..." />
        </div>
        <div class="lg:w-2/3">
          <div class="flex flex-wrap gap-2" id="tags-filter">
            <TagPill tag="todos" active={true} />
            {allTags.map((tag) => (
              <TagPill tag={tag} />
            ))}
          </div>
        </div>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="posts-grid">
        {paginatedPosts.map((post) => (
          <PostCard post={post} />
        ))}
      </div>
      
      {posts.length > ITEMS_PER_PAGE && (
        <div class="mt-12 flex justify-center">
          <a href="/blog/2" class="btn btn-secondary">
            Carregar mais
            <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </a>
        </div>
      )}
    </div>
  </section>
</MainLayout>

<script>
  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const postsGrid = document.getElementById('posts-grid');
  const tagButtons = document.querySelectorAll('#tags-filter .TagPill');
  let allPosts: any[] = [];
  let activeTag = 'todos';
  let searchQuery = '';

  async function loadPosts() {
    const response = await fetch('/api/posts.json');
    allPosts = await response.json();
  }

  function filterPosts() {
    let filtered = allPosts;
    
    if (activeTag !== 'todos') {
      filtered = filtered.filter((p: any) => p.tags.includes(activeTag));
    }
    
    if (searchQuery) {
      const query = searchQuery.toLowerCase();
      filtered = filtered.filter((p: any) => 
        p.title.toLowerCase().includes(query) ||
        p.excerpt.toLowerCase().includes(query) ||
        p.tags.some((t: string) => t.toLowerCase().includes(query))
      );
    }
    
    renderPosts(filtered);
  }

  function renderPosts(posts: any[]) {
    if (!postsGrid) return;
    
    if (posts.length === 0) {
      postsGrid.innerHTML = `
        <div class="col-span-full text-center py-12">
          <p class="text-dark-600 dark:text-dark-400">Nenhum post encontrado.</p>
        </div>
      `;
      return;
    }
    
    postsGrid.innerHTML = posts.map(post => `
      <article class="card group">
        <a href="/blog/${post.slug}" class="block overflow-hidden">
          <img
            src="${post.coverImage}"
            alt="${post.title}"
            class="w-full aspect-[2/1] object-cover transition-transform duration-500 group-hover:scale-105"
            loading="lazy"
          />
        </a>
        <div class="p-6">
          <div class="flex items-center gap-3 mb-3">
            <time class="text-xs text-dark-500 dark:text-dark-500">${new Date(post.date).toLocaleDateString('pt-BR', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
            <span class="text-xs text-dark-300 dark:text-dark-600">•</span>
            <span class="text-xs text-dark-500 dark:text-dark-500">${post.readingTime} min</span>
          </div>
          <h3 class="heading-3 mb-2">
            <a href="/blog/${post.slug}" class="hover:text-primary-600 dark:hover:text-primary-400 transition-colors">
              ${post.title}
            </a>
          </h3>
          <p class="text-dark-600 dark:text-dark-400 mb-4 line-clamp-2">${post.excerpt}</p>
          <div class="flex flex-wrap gap-2">
            ${post.tags.slice(0, 3).map((tag: string) => 
              `<a href="/tags/${tag}" class="text-xs font-medium text-primary-600 dark:text-primary-400 hover:underline">#${tag}</a>`
            ).join('')}
          </div>
        </div>
      </article>
    `).join('');
  }

  searchInput?.addEventListener('input', (e) => {
    searchQuery = (e.target as HTMLInputElement).value;
    filterPosts();
  });

  tagButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      tagButtons.forEach(b => b.classList.remove('active'));
      (btn as HTMLElement).classList.add('active');
      activeTag = (btn as HTMLElement).textContent?.replace('#', '').replace(/\(\d+\)/, '').trim() || 'todos';
      filterPosts();
    });
  });

  loadPosts();
</script>
