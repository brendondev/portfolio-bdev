---
import MainLayout from '@/layouts/MainLayout.astro';
---

<MainLayout title="Contato | Seu Nome" description="Entre em contato para discutir projetos, parcerias ou oportunidades.">
  <div class="page-header">
    <div class="container-custom">
      <h1 class="page-title">Contato</h1>
      <p class="page-description">
        Tem um projeto em mente? Vamos conversar!
      </p>
    </div>
  </div>
  
  <section class="py-16 bg-white dark:bg-dark-900">
    <div class="container-custom">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
        <div>
          <h2 class="heading-2 mb-6">Entre em Contato</h2>
          <p class="text-dark-600 dark:text-dark-400 mb-8">
            Estou sempre aberto a novas oportunidades e projetos interessantes. 
            Sinta-se livre para entrar em contato através de qualquer um dos canais abaixo 
            ou preenchendo o formulário.
          </p>
          
          <div class="space-y-4">
            <a
              href="mailto:seuemail@exemplo.com"
              class="flex items-center gap-4 p-4 card hover:border-primary-300 dark:hover:border-primary-700 transition-colors"
            >
              <div class="w-12 h-12 rounded-lg bg-primary-100 dark:bg-primary-900/30 flex items-center justify-center">
                <svg class="w-6 h-6 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div>
                <p class="font-medium text-dark-900 dark:text-dark-50">Email</p>
                <p class="text-sm text-dark-500 dark:text-dark-500">seuemail@exemplo.com</p>
              </div>
            </a>
            
            <a
              href="https://linkedin.com/in/seuusuario"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-4 p-4 card hover:border-primary-300 dark:hover:border-primary-700 transition-colors"
            >
              <div class="w-12 h-12 rounded-lg bg-primary-100 dark:bg-primary-900/30 flex items-center justify-center">
                <svg class="w-6 h-6 text-primary-600 dark:text-primary-400" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                </svg>
              </div>
              <div>
                <p class="font-medium text-dark-900 dark:text-dark-50">LinkedIn</p>
                <p class="text-sm text-dark-500 dark:text-dark-500">linkedin.com/in/seuusuario</p>
              </div>
            </a>
            
            <a
              href="https://github.com/seuusuario"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-4 p-4 card hover:border-primary-300 dark:hover:border-primary-700 transition-colors"
            >
              <div class="w-12 h-12 rounded-lg bg-primary-100 dark:bg-primary-900/30 flex items-center justify-center">
                <svg class="w-6 h-6 text-primary-600 dark:text-primary-400" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
                </svg>
              </div>
              <div>
                <p class="font-medium text-dark-900 dark:text-dark-50">GitHub</p>
                <p class="text-sm text-dark-500 dark:text-dark-500">github.com/seuusuario</p>
              </div>
            </a>
          </div>
        </div>
        
        <div>
          <div class="card p-8">
            <h3 class="text-xl font-bold text-dark-900 dark:text-dark-50 mb-6">Enviar Mensagem</h3>
            <form class="space-y-4" id="contact-form">
              <div>
                <label for="name" class="block text-sm font-medium text-dark-700 dark:text-dark-300 mb-2">
                  Nome
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  class="w-full px-4 py-3 rounded-lg border border-dark-200 dark:border-dark-700 bg-white dark:bg-dark-800 text-dark-900 dark:text-dark-100 focus:outline-none focus:ring-2 focus:ring-primary-500 transition-colors"
                  placeholder="Seu nome"
                  required
                />
              </div>
              
              <div>
                <label for="email" class="block text-sm font-medium text-dark-700 dark:text-dark-300 mb-2">
                  Email
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  class="w-full px-4 py-3 rounded-lg border border-dark-200 dark:border-dark-700 bg-white dark:bg-dark-800 text-dark-900 dark:text-dark-100 focus:outline-none focus:ring-2 focus:ring-primary-500 transition-colors"
                  placeholder="seu@email.com"
                  required
                />
              </div>
              
              <div>
                <label for="subject" class="block text-sm font-medium text-dark-700 dark:text-dark-300 mb-2">
                  Assunto
                </label>
                <select
                  id="subject"
                  name="subject"
                  class="w-full px-4 py-3 rounded-lg border border-dark-200 dark:border-dark-700 bg-white dark:bg-dark-800 text-dark-900 dark:text-dark-100 focus:outline-none focus:ring-2 focus:ring-primary-500 transition-colors"
                >
                  <option value="project">Projeto</option>
                  <option value="job">Oportunidade de Trabalho</option>
                  <option value="question">Pergunta</option>
                  <option value="other">Outro</option>
                </select>
              </div>
              
              <div>
                <label for="message" class="block text-sm font-medium text-dark-700 dark:text-dark-300 mb-2">
                  Mensagem
                </label>
                <textarea
                  id="message"
                  name="message"
                  rows="5"
                  class="w-full px-4 py-3 rounded-lg border border-dark-200 dark:border-dark-700 bg-white dark:bg-dark-800 text-dark-900 dark:text-dark-100 focus:outline-none focus:ring-2 focus:ring-primary-500 transition-colors resize-none"
                  placeholder="Sua mensagem..."
                  required
                ></textarea>
              </div>
              
              <button
                type="submit"
                class="w-full btn btn-primary"
              >
                Enviar Mensagem
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>
</MainLayout>

<script>
  const form = document.getElementById('contact-form');
  
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    
    const formData = new FormData(e.target as HTMLFormElement);
    const data = Object.fromEntries(formData);
    
    const mailtoLink = `mailto:seuemail@exemplo.com?subject=${encodeURIComponent(`Contato: ${data.subject}`)}&body=${encodeURIComponent(`Nome: ${data.name}\nEmail: ${data.email}\n\nMensagem:\n${data.message}`)}`;
    
    window.location.href = mailtoLink;
  });
</script>
