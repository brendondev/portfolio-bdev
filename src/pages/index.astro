---
import MainLayout from '@/layouts/MainLayout.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import PostCard from '@/components/PostCard.astro';
import { getProjects, getPosts, getAllTags } from '@/lib';

const projects = await getProjects();
const posts = await getPosts();
const allTags = getAllTags(projects, posts);
const featuredProjects = projects.slice(0, 3);
const recentPosts = posts.slice(0, 3);

const services = [
  {
    title: 'Desenvolvimento Web',
    description: 'Sites e aplicações web modernos, responsivos e otimizados para performance.'
  },
  {
    title: 'UI/UX Design',
    description: 'Interfaces intuitivas e agradáveis focadas na experiência do usuário.'
  },
  {
    title: 'SEO & Analytics',
    description: 'Otimização para mecanismos de busca e análise de métricas de performance.'
  }
];
---

<MainLayout>
  <section class="relative overflow-hidden bg-gradient-to-b from-dark-50 to-white dark:from-dark-900 dark:to-dark-800">
    <div class="container-custom py-24 sm:py-32">
      <div class="max-w-3xl">
        <h1 class="heading-1 mb-6 animate-fade-in">
          Desenvolvedor &<br />
          <span class="text-gradient">Designer Digital</span>
        </h1>
        <p class="text-xl text-dark-600 dark:text-dark-400 mb-8 max-w-2xl animate-fade-in animation-delay-100">
          Crio experiências digitais modernas, rápidas e acessíveis que ajudam empresas a crescer no mundo online.
        </p>
        <div class="flex flex-wrap gap-4 animate-fade-in animation-delay-200">
          <a href="/projects" class="btn btn-primary">
            Ver Projetos
            <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
          <a href="/contact" class="btn btn-secondary">
            Falar Comigo
          </a>
        </div>
      </div>
    </div>
    
    <div class="absolute top-0 right-0 -translate-y-1/4 translate-x-1/4 w-96 h-96 bg-primary-100 dark:bg-primary-900/20 rounded-full blur-3xl" aria-hidden="true"></div>
    <div class="absolute bottom-0 left-0 translate-y-1/4 -translate-x-1/4 w-96 h-96 bg-primary-100 dark:bg-primary-900/20 rounded-full blur-3xl" aria-hidden="true"></div>
  </section>

  <section class="py-16 sm:py-24 bg-white dark:bg-dark-900">
    <div class="container-custom">
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-12">
        <div>
          <h2 class="heading-2 mb-2">Projetos em Destaque</h2>
          <p class="text-dark-600 dark:text-dark-400">Alguns dos meus trabalhos recentes</p>
        </div>
        <a href="/projects" class="text-primary-600 dark:text-primary-400 font-medium hover:underline">
          Ver todos →
        </a>
      </div>
      
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        {featuredProjects.map((project) => (
          <ProjectCard project={project} featured={true} />
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 sm:py-24 bg-dark-50 dark:bg-dark-950">
    <div class="container-custom">
      <div class="max-w-2xl mb-12">
        <h2 class="heading-2 mb-4">O que eu faço</h2>
        <p class="text-dark-600 dark:text-dark-400">
          Serviços especializados para ajudar sua empresa a se destacar no digital.
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {services.map((service, index) => (
          <div class="card p-8 animate-slide-up" style={`animation-delay: ${index * 100}ms`}>
            <div class="w-12 h-12 rounded-lg bg-primary-100 dark:bg-primary-900/30 flex items-center justify-center mb-6">
              <svg class="w-6 h-6 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-dark-900 dark:text-dark-50 mb-3">{service.title}</h3>
            <p class="text-dark-600 dark:text-dark-400">{service.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 sm:py-24 bg-white dark:bg-dark-900">
    <div class="container-custom">
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-12">
        <div>
          <h2 class="heading-2 mb-2">Últimos Posts</h2>
          <p class="text-dark-600 dark:text-dark-400">Artigos sobre desenvolvimento e design</p>
        </div>
        <a href="/blog" class="text-primary-600 dark:text-primary-400 font-medium hover:underline">
          Ver todos →
        </a>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {recentPosts.map((post) => (
          <PostCard post={post} />
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 sm:py-24 bg-primary-600">
    <div class="container-custom text-center">
      <h2 class="heading-2 text-white mb-4">Pronto para começar seu projeto?</h2>
      <p class="text-primary-100 mb-8 max-w-2xl mx-auto">
        Entre em contato e vamos discutir como posso ajudar a realizar sua ideia.
      </p>
      <a href="/contact" class="btn bg-white text-primary-600 hover:bg-primary-50 focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-primary-600">
        Falar Comigo
      </a>
    </div>
  </section>
</MainLayout>
