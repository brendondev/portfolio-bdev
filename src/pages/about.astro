---
import MainLayout from '@/layouts/MainLayout.astro';

const experience = [
  {
    year: '2023 - Presente',
    title: 'Desenvolvedor Senior',
    company: 'Empresa Tech',
    description: 'Liderança técnica em projetos de grande escala, arquitetura de sistemas e mentoria de desenvolvedores júnior.'
  },
  {
    year: '2021 - 2023',
    title: 'Desenvolvedor Full Stack',
    company: 'Startup Digital',
    description: 'Desenvolvimento de aplicações web utilizando React, Node.js e cloud services. Participação no crescimento da empresa de 10 para 50 funcionários.'
  },
  {
    year: '2019 - 2021',
    title: 'Desenvolvedor Front-end',
    company: 'Agência Digital',
    description: 'Criação de sites institucionais, landing pages e e-commerces para diversos clientes. Experiência com design systems e componentização.'
  },
  {
    year: '2018 - 2019',
    title: 'Designer UI/UX',
    company: 'Estúdio Criativo',
    description: 'Design de interfaces para aplicativos mobile e web. Pesquisas de usuário, prototipagem e criação de design systems.'
  }
];

const skills = [
  'JavaScript/TypeScript',
  'React/Next.js',
  'Node.js',
  'Astro',
  'Tailwind CSS',
  'PostgreSQL',
  'AWS',
  'Figma',
  'Git',
  'Docker'
];
---

<MainLayout title="Sobre | Seu Nome" description="Conheça mais sobre minha trajetória profissional e habilidades técnicas.">
  <div class="page-header">
    <div class="container-custom">
      <h1 class="page-title">Sobre</h1>
      <p class="page-description">
        Desenvolvedor apaixonado por criar experiências digitais que fazem a diferença.
      </p>
    </div>
  </div>
  
  <section class="py-16 bg-white dark:bg-dark-900">
    <div class="container-custom">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 mb-16">
        <div>
          <h2 class="heading-2 mb-6">Minha História</h2>
          <div class="prose dark:prose-invert text-dark-600 dark:text-dark-400">
            <p class="mb-4">
              Comecei minha carreira no mundo digital há mais de 5 anos, inicialmente como designer antes de migrar para o desenvolvimento. Essa background em design me ajuda a criar soluções que são tanto funcionais quanto visualmente agradáveis.
            </p>
            <p class="mb-4">
              Hoje, trabalho como desenvolvedor full-stack, criando aplicações web modernas e performáticas. Meu foco está em tecnologias web baseadas em JavaScript/TypeScript, com ênfase em frameworks modernos como React, Next.js e Astro.
            </p>
            <p>
              Fora do trabalho, contribuo para projetos open-source, escrevo artigos técnicos e estou sempre aprendendo algo novo. Também gosto de participar de meetups e conferências da comunidade de desenvolvimento.
            </p>
          </div>
        </div>
        
        <div class="space-y-6">
          <div class="card p-6">
            <h3 class="text-lg font-bold text-dark-900 dark:text-dark-50 mb-4">Stack & Ferramentas</h3>
            <div class="flex flex-wrap gap-2">
              {skills.map((skill) => (
                <span class="px-3 py-1.5 bg-dark-100 dark:bg-dark-700 text-dark-700 dark:text-dark-300 rounded-full text-sm">
                  {skill}
                </span>
              ))}
            </div>
          </div>
          
          <div class="card p-6">
            <h3 class="text-lg font-bold text-dark-900 dark:text-dark-50 mb-4">Idiomas</h3>
            <ul class="space-y-2 text-dark-600 dark:text-dark-400">
              <li class="flex justify-between">
                <span>Português</span>
                <span class="font-medium text-dark-900 dark:text-dark-50">Nativo</span>
              </li>
              <li class="flex justify-between">
                <span>Inglês</span>
                <span class="font-medium text-dark-900 dark:text-dark-50">Avançado</span>
              </li>
              <li class="flex justify-between">
                <span>Espanhol</span>
                <span class="font-medium text-dark-900 dark:text-dark-50">Intermediário</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
      
      <div>
        <h2 class="heading-2 mb-8">Experiência</h2>
        <div class="space-y-6">
          {experience.map((item) => (
            <div class="card p-6">
              <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4 mb-4">
                <div>
                  <span class="text-sm text-primary-600 dark:text-primary-400 font-medium">{item.year}</span>
                  <h3 class="text-xl font-bold text-dark-900 dark:text-dark-50 mt-1">{item.title}</h3>
                  <p class="text-dark-600 dark:text-dark-400">{item.company}</p>
                </div>
              </div>
              <p class="text-dark-600 dark:text-dark-400">{item.description}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
</MainLayout>
