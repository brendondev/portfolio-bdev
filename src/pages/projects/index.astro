---
import MainLayout from '@/layouts/MainLayout.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import SearchInput from '@/components/SearchInput.astro';
import TagPill from '@/components/TagPill.astro';
import { getProjects, getAllTags, searchContent } from '@/lib';

const projects = await getProjects();
const allTags = getAllTags(projects, []);

const ITEMS_PER_PAGE = 9;
const totalPages = Math.ceil(projects.length / ITEMS_PER_PAGE);
const currentPage = 1;
const paginatedProjects = projects.slice(0, ITEMS_PER_PAGE);
---

<MainLayout title="Projetos | Seu Nome" description="Veja meus projetos de desenvolvimento web, design UI/UX e soluções digitais.">
  <div class="page-header">
    <div class="container-custom">
      <h1 class="page-title">Projetos</h1>
      <p class="page-description">
        Uma seleção dos meus trabalhos mais recentes em desenvolvimento web e design.
      </p>
    </div>
  </div>
  
  <section class="py-12 bg-white dark:bg-dark-900">
    <div class="container-custom">
      <div class="flex flex-col lg:flex-row gap-8 mb-12">
        <div class="lg:w-1/3">
          <SearchInput placeholder="Buscar projetos..." />
        </div>
        <div class="lg:w-2/3">
          <div class="flex flex-wrap gap-2" id="tags-filter">
            <TagPill tag="todos" active={true} />
            {allTags.map((tag) => (
              <TagPill tag={tag} />
            ))}
          </div>
        </div>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8" id="projects-grid">
        {paginatedProjects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
      
      {projects.length > ITEMS_PER_PAGE && (
        <div class="mt-12 flex justify-center">
          <a href="/projects/2" class="btn btn-secondary">
            Carregar mais
            <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </a>
        </div>
      )}
    </div>
  </section>
</MainLayout>

<script>
  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const projectsGrid = document.getElementById('projects-grid');
  const tagButtons = document.querySelectorAll('#tags-filter .TagPill');
  let allProjects: any[] = [];
  let activeTag = 'todos';
  let searchQuery = '';

  async function loadProjects() {
    const response = await fetch('/api/projects.json');
    allProjects = await response.json();
  }

  function filterProjects() {
    let filtered = allProjects;
    
    if (activeTag !== 'todos') {
      filtered = filtered.filter((p: any) => p.tags.includes(activeTag));
    }
    
    if (searchQuery) {
      const query = searchQuery.toLowerCase();
      filtered = filtered.filter((p: any) => 
        p.title.toLowerCase().includes(query) ||
        p.headline.toLowerCase().includes(query) ||
        p.tags.some((t: string) => t.toLowerCase().includes(query))
      );
    }
    
    renderProjects(filtered);
  }

  function renderProjects(projects: any[]) {
    if (!projectsGrid) return;
    
    if (projects.length === 0) {
      projectsGrid.innerHTML = `
        <div class="col-span-full text-center py-12">
          <p class="text-dark-600 dark:text-dark-400">Nenhum projeto encontrado.</p>
        </div>
      `;
      return;
    }
    
    projectsGrid.innerHTML = projects.map(project => `
      <article class="card group">
        <div class="overflow-hidden">
          <img
            src="${project.coverImage}"
            alt="${project.title}"
            class="w-full aspect-[4/3] object-cover transition-transform duration-500 group-hover:scale-105"
            loading="lazy"
            width="800"
            height="600"
          />
        </div>
        <div class="p-6">
          <div class="flex items-center gap-3 mb-3">
            <span class="text-xs font-medium text-primary-600 dark:text-primary-400 bg-primary-50 dark:bg-primary-900/30 px-2 py-1 rounded">
              ${project.year}
            </span>
            <div class="flex gap-1">
              ${project.tags.slice(0, 2).map((tag: string) => 
                `<span class="text-xs text-dark-500 dark:text-dark-500">#${tag}</span>`
              ).join('')}
            </div>
          </div>
          <h3 class="heading-3 mb-2">
            <a href="/projects/${project.slug}" class="hover:text-primary-600 dark:hover:text-primary-400 transition-colors">
              ${project.title}
            </a>
          </h3>
          <p class="text-dark-600 dark:text-dark-400 mb-4 line-clamp-3">${project.headline}</p>
        </div>
      </article>
    `).join('');
  }

  searchInput?.addEventListener('input', (e) => {
    searchQuery = (e.target as HTMLInputElement).value;
    filterProjects();
  });

  tagButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      tagButtons.forEach(b => b.classList.remove('active'));
      (btn as HTMLElement).classList.add('active');
      activeTag = (btn as HTMLElement).textContent?.replace('#', '').replace(/\(\d+\)/, '').trim() || 'todos';
      filterProjects();
    });
  });

  loadProjects();
</script>
