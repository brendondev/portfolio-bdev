---
import MainLayout from '@/layouts/MainLayout.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import { getProjectBySlug, getProjects } from '@/lib';

const { slug } = Astro.params;
const project = await getProjectBySlug(slug!);

if (!project) {
  return Astro.redirect('/404');
}

const allProjects = await getProjects();
const relatedProjects = allProjects
  .filter(p => p.slug !== project.slug && p.tags.some(t => project.tags.includes(t)))
  .slice(0, 3);
---

<MainLayout
  title={`${project.title} | Seu Nome`}
  description={project.headline}
  image={project.coverImage}
  type="article"
  publishedTime={project.year}
  author={project.role}
  tags={project.tags}
>
  <article>
    <div class="page-header">
      <div class="container-custom">
        <div class="flex flex-wrap items-center gap-4 mb-6">
          <span class="text-sm font-medium text-primary-600 dark:text-primary-400 bg-primary-50 dark:bg-primary-900/30 px-3 py-1 rounded-full">
            {project.year}
          </span>
          {project.tags.map((tag) => (
            <span class="text-sm text-dark-500 dark:text-dark-500">#{tag}</span>
          ))}
        </div>
        <h1 class="page-title">{project.title}</h1>
        <p class="page-description text-xl">{project.headline}</p>
      </div>
    </div>
    
    <div class="py-12 bg-white dark:bg-dark-900">
      <div class="container-custom">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
          <div class="lg:col-span-2 space-y-12">
            <div class="rounded-xl overflow-hidden bg-dark-100 dark:bg-dark-800">
              <img
                src={project.coverImage}
                alt={project.title}
                class="w-full"
                width="1200"
                height="600"
              />
            </div>
            
            {project.gallery.length > 0 && (
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                {project.gallery.map((image, index) => (
                  <div class="rounded-lg overflow-hidden bg-dark-100 dark:bg-dark-800">
                    <img
                      src={image}
                      alt={`${project.title} - Imagem ${index + 1}`}
                      class="w-full"
                      loading="lazy"
                    />
                  </div>
                ))}
              </div>
            )}
            
            <div class="prose dark:prose-invert max-w-none">
              <h2 class="heading-3 mb-4">O Problema</h2>
              <p class="text-dark-600 dark:text-dark-400">{project.problem}</p>
              
              <h2 class="heading-3 mb-4 mt-8">A Solução</h2>
              <p class="text-dark-600 dark:text-dark-400">{project.solution}</p>
              
              <h2 class="heading-3 mb-4 mt-8">Resultados</h2>
              <ul class="space-y-2">
                {project.results.map((result) => (
                  <li class="flex items-start gap-3 text-dark-600 dark:text-dark-400">
                    <svg class="w-5 h-5 text-primary-600 dark:text-primary-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    {result}
                  </li>
                ))}
              </ul>
            </div>
          </div>
          
          <div class="lg:col-span-1">
            <div class="sticky top-24 space-y-6">
              <div class="card p-6">
                <h3 class="text-lg font-bold text-dark-900 dark:text-dark-50 mb-4">Detalhes do Projeto</h3>
                
                <div class="space-y-4">
                  <div>
                    <span class="text-sm text-dark-500 dark:text-dark-500">Role</span>
                    <p class="font-medium text-dark-900 dark:text-dark-50">{project.role}</p>
                  </div>
                  
                  <div>
                    <span class="text-sm text-dark-500 dark:text-dark-500">Stack</span>
                    <div class="flex flex-wrap gap-2 mt-1">
                      {project.stack.map((tech) => (
                        <span class="text-sm bg-dark-100 dark:bg-dark-700 px-2 py-1 rounded">
                          {tech}
                        </span>
                      ))}
                    </div>
                  </div>
                  
                  {project.links.length > 0 && (
                    <div>
                      <span class="text-sm text-dark-500 dark:text-dark-500">Links</span>
                      <div class="flex flex-col gap-2 mt-2">
                        {project.links.map((link) => (
                          <a
                            href={link.url}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="text-sm text-primary-600 dark:text-primary-400 hover:underline"
                          >
                            {link.label} →
                          </a>
                        ))}
                      </div>
                    </div>
                  )}
                </div>
              </div>
            </div>
          </div>
        </div>
        
        {relatedProjects.length > 0 && (
          <div class="mt-16 pt-16 border-t border-dark-200 dark:border-dark-800">
            <h2 class="heading-2 mb-8">Projetos Relacionados</h2>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
              {relatedProjects.map((project) => (
                <ProjectCard project={project} />
              ))}
            </div>
          </div>
        )}
      </div>
    </div>
  </article>
</MainLayout>
