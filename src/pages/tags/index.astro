---
import MainLayout from '@/layouts/MainLayout.astro';
import TagPill from '@/components/TagPill.astro';
import { getProjects, getPosts, getAllTags } from '@/lib';

const projects = await getProjects();
const posts = await getPosts();
const allTags = getAllTags(projects, posts);
---

<MainLayout title="Tags | Seu Nome" description="Navegue por todas as tags do site.">
  <div class="page-header">
    <div class="container-custom">
      <h1 class="page-title">Tags</h1>
      <p class="page-description">
        Navegue por todas as tags e categorias do site.
      </p>
    </div>
  </div>
  
  <section class="py-16 bg-white dark:bg-dark-900">
    <div class="container-custom">
      <div class="flex flex-wrap gap-4">
        {allTags.map((tag) => {
          const count = [...projects.filter(p => p.tags.includes(tag)).length + ...posts.filter(p => p.tags.includes(tag)).length];
          return (
            <TagPill tag={tag} count={count} />
          );
        })}
      </div>
    </div>
  </section>
</MainLayout>
