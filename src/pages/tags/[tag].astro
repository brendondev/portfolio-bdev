---
import MainLayout from '@/layouts/MainLayout.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import PostCard from '@/components/PostCard.astro';
import { getProjects, getPosts, getProjectsByTag, getPostsByTag } from '@/lib';

const { tag } = Astro.params;
const projects = await getProjects();
const posts = await getPosts();

const filteredProjects = getProjectsByTag(projects, tag!);
const filteredPosts = getPostsByTag(posts, tag!);

const pageTitle = `#${tag} | Seu Nome`;
---

<MainLayout title={pageTitle} description={`Conteúdo relacionado à tag ${tag}`}>
  <div class="page-header">
    <div class="container-custom">
      <span class="text-sm text-primary-600 dark:text-primary-400 font-medium mb-2">Tag</span>
      <h1 class="page-title">#{tag}</h1>
      <p class="page-description">
        {filteredProjects.length + filteredPosts.length} itens encontrados
      </p>
    </div>
  </div>
  
  <section class="py-16 bg-white dark:bg-dark-900">
    <div class="container-custom">
      {filteredProjects.length > 0 && (
        <>
          <h2 class="heading-2 mb-8">Projetos</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16">
            {filteredProjects.map((project) => (
              <ProjectCard project={project} />
            ))}
          </div>
        </>
      )}
      
      {filteredPosts.length > 0 && (
        <>
          <h2 class="heading-2 mb-8">Posts</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {filteredPosts.map((post) => (
              <PostCard post={post} />
            ))}
          </div>
        </>
      )}
      
      {filteredProjects.length === 0 && filteredPosts.length === 0 && (
        <div class="text-center py-12">
          <p class="text-dark-600 dark:text-dark-400">Nenhum conteúdo encontrado para esta tag.</p>
        </div>
      )}
    </div>
  </section>
</MainLayout>
