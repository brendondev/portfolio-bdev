---
import type { Post } from '@/lib';
import { formatDate, formatReadingTime } from '@/lib/utils';

interface Props {
  post: Post;
}

const { post } = Astro.props;
---

<article class="card group">
  <a href={`/blog/${post.slug}`} class="block overflow-hidden">
    <img
      src={post.coverImage}
      alt={post.title}
      class="w-full aspect-[2/1] object-cover transition-transform duration-500 group-hover:scale-105"
      loading="lazy"
      width="800"
      height="400"
    />
  </a>
  
  <div class="p-6">
    <div class="flex items-center gap-3 mb-3">
      <time datetime={post.date} class="text-xs text-dark-500 dark:text-dark-500">
        {formatDate(post.date)}
      </time>
      <span class="text-xs text-dark-300 dark:text-dark-600">•</span>
      <span class="text-xs text-dark-500 dark:text-dark-500">
        {formatReadingTime(post.readingTime)}
      </span>
    </div>
    
    <h3 class="heading-3 mb-2 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">
      <a href={`/blog/${post.slug}`} class="focus:outline-none">
        <span class="absolute inset-0" aria-hidden="true"></span>
        {post.title}
      </a>
    </h3>
    
    <p class="text-dark-600 dark:text-dark-400 mb-4 line-clamp-2">
      {post.excerpt}
    </p>
    
    <div class="flex flex-wrap gap-2">
      {post.tags.slice(0, 3).map((tag) => (
        <a
          href={`/tags/${tag}`}
          class="text-xs font-medium text-primary-600 dark:text-primary-400 hover:underline"
        >
          #{tag}
        </a>
      ))}
    </div>
  </div>
</article>
