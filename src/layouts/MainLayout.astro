---
import BaseLayout from './BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import type { SEOProps } from '@/lib';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  tags?: string[];
  noIndex?: boolean;
}

const {
  title = 'Seu Nome | Desenvolvedor & Designer',
  description = 'Portfólio profissional com projetos de desenvolvimento web, design UI/UX e soluções digitais.',
  image = '/og-image.png',
  canonical,
  type = 'website',
  publishedTime,
  modifiedTime,
  author = 'Seu Nome',
  tags,
  noIndex = false
} = Astro.props;

const seo: SEOProps = {
  title,
  description,
  image,
  canonical,
  type,
  publishedTime,
  modifiedTime,
  author,
  tags
};

const robotsContent = noIndex ? 'noindex, nofollow' : 'index, follow';
---

<BaseLayout seo={seo}>
  <Header />
  <main className="flex-1">
    <slot />
  </main>
  <Footer />
</BaseLayout>

<style is:global>
  .page-header {
    @apply py-16 sm:py-24 bg-gradient-to-b from-dark-50 to-white dark:from-dark-900 dark:to-dark-800;
  }
  
.page-title {
  @apply text-4xl sm:text-5xl font-bold text-dark-900 dark:text-dark-50 mb-4;
}

  
  .page-description {
    @apply text-lg text-dark-600 dark:text-dark-400 max-w-2xl;
  }
</style>
