import type { SEOProps } from '@/lib';
import '../styles/global.css';

interface BaseLayoutProps {
  children: React.ReactNode;
  seo?: SEOProps;
}

const defaultSEO: SEOProps = {
  title: 'Seu Nome | Desenvolvedor & Designer',
  description: 'Portfólio profissional com projetos de desenvolvimento web, design UI/UX e soluções digitais.',
  image: '/og-image.png',
  type: 'website'
};

export default function BaseLayout({ children, seo = {} }: BaseLayoutProps) {
  const fullSEO = { ...defaultSEO, ...seo };
  const siteUrl = 'https://yourname.github.io';
  const canonicalUrl = seo.canonical ? `${siteUrl}${seo.canonical}` : siteUrl;

  return (
    <html lang="pt-BR" className="dark">
      <head>
        <meta charSet="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="sitemap" href="/sitemap-index.xml" />
        <link rel="alternate" type="application/rss+xml" title="RSS Feed" href="/rss.xml" />
        
        <title>{fullSEO.title}</title>
        <meta name="description" content={fullSEO.description} />
        <link rel="canonical" href={canonicalUrl} />
        
        <meta property="og:type" content={fullSEO.type} />
        <meta property="og:title" content={fullSEO.title} />
        <meta property="og:description" content={fullSEO.description} />
        <meta property="og:image" content={fullSEO.image ? `${siteUrl}${fullSEO.image}` : ''} />
        <meta property="og:url" content={canonicalUrl} />
        
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={fullSEO.title} />
        <meta name="twitter:description" content={fullSEO.description} />
        <meta name="twitter:image" content={fullSEO.image ? `${siteUrl}${fullSEO.image}` : ''} />
        
        {fullSEO.type === 'article' && (
          <>
            <meta property="article:published_time" content={fullSEO.publishedTime} />
            {fullSEO.modifiedTime && <meta property="article:modified_time" content={fullSEO.modifiedTime} />}
            {fullSEO.author && <meta property="article:author" content={fullSEO.author} />}
            {fullSEO.tags?.map((tag) => (
              <meta key={tag} property="article:tag" content={tag} />
            ))}
          </>
        )}
        
        <script
          type="application/ld+json"
          dangerouslySetInnerHTML={{
            __html: JSON.stringify({
              '@context': 'https://schema.org',
              '@type': 'WebSite',
              name: 'Seu Nome',
              url: siteUrl,
              description: fullSEO.description,
              potentialAction: {
                '@type': 'SearchAction',
                target: `${siteUrl}/blog?q={search_term_string}`,
                'query-input': 'required name=search_term_string'
              }
            })
          }}
        />
        
        <script
          type="text/javascript"
          dangerouslySetInnerHTML={{
            __html: `
              (function() {
                const theme = localStorage.getItem('theme');
                const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
                if (theme === 'dark' || (!theme && systemDark)) {
                  document.documentElement.classList.add('dark');
                } else {
                  document.documentElement.classList.remove('dark');
                }
              })();
            `
          }}
        />
      </head>
      <body className="min-h-screen flex flex-col">
        {children}
      </body>
    </html>
  );
}
